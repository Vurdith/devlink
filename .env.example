# DevLink environment variables
# Copy this file to .env for local development, or set these values in your host for production.

# Database (Supabase / PostgreSQL)
# App runtime should use the pooler connection when deployed to serverless hosting.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true

# Migrations should use the direct database connection.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Public app URL
# Production should use https://devlink.ink or the final canonical domain.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Redis cache and rate limiting
# Upstash Redis is recommended for serverless hosting.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Alternative standard Redis connection:
# REDIS_URL=redis://user:pass@host:6379

# Optional read replica for feed/search/profile reads:
# READ_DATABASE_URL=postgresql://user:password@read-replica-host:6543/postgres?pgbouncer=true

# Object storage: S3-compatible, Cloudflare R2-friendly
# Required in production for uploads.
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_NAME=devlink
S3_REGION=auto
S3_PUBLIC_URL=https://cdn.yourdomain.com

# OAuth providers
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

APPLE_ID=
APPLE_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="DevLink <noreply@yourdomain.com>"

# Async jobs / event bus / hotpath services
EVENT_BUS_MODE=inmemory
# EVENT_BUS_MODE=http
# EVENT_BUS_HTTP_ENDPOINT=https://your-event-gateway.dev/events
# EVENT_BUS_HTTP_TOKEN=your-event-token

# Optional Rust hotpath integrations
RUST_HOTPATH_SERVICE_URL=
NEXT_PUBLIC_RUST_REALTIME_URL=

# Search provider configuration
SEARCH_PROVIDER=prisma
# SEARCH_PROVIDER=meilisearch
# MEILI_URL=http://localhost:7700
# MEILI_API_KEY=your-meili-api-key
# SEARCH_PROVIDER=typesense
# TYPESENSE_URL=http://localhost:8108
# TYPESENSE_API_KEY=your-typesense-api-key

# Security hardening
SECURITY_ENABLE_ANOMALY_DETECTION=true
SECURITY_ENABLE_DEVICE_FINGERPRINTING=true

# Optional AI features
OPENAI_API_KEY=

# Sentry error tracking and performance monitoring
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=javascript-nextjs
# SENTRY_AUTH_TOKEN=your-auth-token
# SENTRY_DEBUG=true

# OpenTelemetry
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel-collector.example.com/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-token
